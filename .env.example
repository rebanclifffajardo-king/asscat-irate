# --- Supabase (Project Settings → API) ---------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. NEVER expose to the browser or prefix with NEXT_PUBLIC_.
# Used only for: creating/deactivating auth accounts, ID-based login lookup,
# writing tamper-proof activity logs, and the notifications cron.
SUPABASE_SERVICE_ROLE_KEY=

# --- Application ---------------------------------------------------------------
# Public base URL used in password-reset emails (e.g. https://irate.asscat.edu.ph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Shared secret for /api/cron/notifications (Vercel Cron sends it as a Bearer token)
CRON_SECRET=
